<header>
  <nav id="navbar" class="navbar navbar-light {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container">
      {% comment %} A shell prompt showing where you are, e.g. ~/blog/<post>. Links home. {% endcomment %}
      {% if page.url == '/' %}
        {% assign prompt_path = '~' %}
      {% elsif page.url == '/blog/' or page.url == '/blog/index.html' or page.url contains '/blog/page/' %}
        {% assign prompt_path = '~/blog' %}
      {% elsif page.collection == 'posts' %}
        {% assign prompt_path = page.slug | prepend: '~/blog/' %}
      {% else %}
        {% assign prompt_path = page.url | remove: 'index.html' | remove: '.html' | split: '/' | join: '/' | prepend: '~' %}
      {% endif %}
      <a class="navbar-prompt" href="{{ '/' | relative_url }}" aria-label="Home">
        <span class="np-user">isg@gctl.io</span><span class="np-sep">:</span><span class="np-path">{{ prompt_path }}</span>
        <span class="np-dollar">$</span><span class="np-cursor" aria-hidden="true"></span>
      </a>

      <ul class="navbar-nav navbar-menu-list">
        <li class="nav-item {% if page.permalink == '/' %}active{% endif %}">
          <a class="nav-link" href="{{ '/' | relative_url }}">/</a>
        </li>
        <li class="nav-item {% if page.url contains '/blog' %}active{% endif %}">
          <a class="nav-link" href="{{ '/blog/' | relative_url }}">/blog</a>
        </li>
        {% if site.search_enabled %}
          <li class="nav-item">
            <button id="search-toggle" type="button" title="Search (ctrl k)" aria-label="Open search">
              <span class="nav-link"><span class="search-hint">ctrl k</span> <i class="fa-solid fa-magnifying-glass"></i></span>
            </button>
          </li>
        {% endif %}
      </ul>

      <div class="navbar-social social">{% social_links %}</div>
    </div>
  </nav>
</header>
