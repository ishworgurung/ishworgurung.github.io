<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="footer-social">{% social_links %}</div>
    <p class="footer-text">
      &copy; {{ site.time | date: '%Y' }} {{ site.first_name }} {{ site.last_name }}. {{ site.footer_text }}
    </p>
  </div>
</footer>

{% if site.search_enabled %}
  {% comment %} Adds post-body matches to the search box. {% endcomment %}
  <script defer src="{{ '/assets/js/search-fulltext.js' | relative_url }}"></script>
{% endif %}
